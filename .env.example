# Copia este archivo como .env y configura tus valores
# cp .env.example .env

# Clave secreta para sesiones y CSRF (generar con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Base de datos PostgreSQL
DATABASE_URL=postgresql://gestor_user:gestor_secret_2024@db:5432/sistema_academico
POSTGRES_PASSWORD=gestor_secret_2024

# Redis (broker para Celery y almacenamiento de progreso)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Debug mode (0 = desactivado, 1 = activado) - NUNCA activar en produccion
FLASK_DEBUG=0

# Clave de encriptacion para backups AES-256-GCM (generar con: python backup_manager.py genkey)
BACKUP_ENCRYPTION_KEY=

# API Key para integracion con sistemas externos (generar con: python -c "import secrets; print(secrets.token_hex(32))")
EXTERNAL_API_KEY=
